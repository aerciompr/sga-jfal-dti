DB_NAME=justica_senhas
DB_USER=sga
# Gere valores individuais aleatórios. Nunca reutilize senhas do arquivo antigo.
DB_PASS=
MYSQL_ROOT_PASSWORD=
BOOTSTRAP_ADMIN_PASSWORD=
SYS_NAME=Justiça Federal
# 1 atrás de proxy HTTPS; 0 exclusivamente em homologação HTTP local.
SESSION_SECURE=1
# IPs exatos dos proxies autorizados a definir X-Real-IP; vazio não confia em cabeçalhos.
TRUSTED_PROXY_IPS=
# Escuta local para proxy reverso. Ajuste conscientemente se o proxy estiver em outro host.
WEB_BIND=127.0.0.1
WEB_PORT=8085
