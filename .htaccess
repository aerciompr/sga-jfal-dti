Options -Indexes -MultiViews
<FilesMatch "^(config|banco|youtube|seguranca|atendimento_service|pauta_service|usuarios_service|importacao_service|tv_autorizacao)\.php$">
    Require all denied
</FilesMatch>
<FilesMatch "\.(py|md|ya?ml|ini|json|lock|sql|log|env|txt)$">
    Require all denied
</FilesMatch>
<FilesMatch "^\.">
    Require all denied
</FilesMatch>

DirectoryIndex index.php

RewriteEngine On

# Bloqueio de pastas internas
RewriteRule ^(?:scripts|tests|docker|node_modules)/ - [F,L]

# Resolução transparente de URLs amigáveis: mapeia rota sem .php para o script .php correspondente
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME}.php -f
RewriteRule ^(.+?)/?$ $1.php [L,QSA]
