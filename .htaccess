Options -Indexes
<FilesMatch "^(config|banco|seguranca|atendimento_service|pauta_service|usuarios_service|importacao_service|tv_autorizacao)\.php$">
    Require all denied
</FilesMatch>
<FilesMatch "\.(py|md|ya?ml|ini|json|lock|sql|log|env|txt)$">
    Require all denied
</FilesMatch>
<FilesMatch "^\.">
    Require all denied
</FilesMatch>
RewriteEngine On
RewriteRule ^(?:scripts|tests|docker|node_modules)/ - [F,L]
